{% endfor %}
- Recommendations:
{% for r in digest.recommendations %}
  - {{ r.title }} ({{ r.role }}): {{ r.rationale | join(" ") }}
{% endfor %}
- Open questions for the client:
{% for q in digest.questions %}
  - {{ q }}
{% else %}
