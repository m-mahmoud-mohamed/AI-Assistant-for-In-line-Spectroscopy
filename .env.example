# Copy to .env (git-ignored). Choose the LLM profile defined in config/llm.yaml: openai | gemini | gwdg | project.
# The committed H01–H06 answers were generated with the "openai" profile.
PRISM_LLM_PROFILE=openai
OPENAI_API_KEY=
# Gemini (profile "gemini"); optional fallback keys GEMINI_API_KEY_2 ... GEMINI_API_KEY_9 take over on a 429.
GEMINI_API_KEY=
# GWDG Chat AI (profile "gwdg").
SAIA_API_KEY=
# For the project's own provider (profile "project"):
PRISM_LLM_API_KEY=
PRISM_LLM_BASE_URL=
# 1 = use only cached LLM responses (no network); used by verify-outputs and CI.
PRISM_REPLAY=0
PRISM_CACHE_DIR=.prism_cache
