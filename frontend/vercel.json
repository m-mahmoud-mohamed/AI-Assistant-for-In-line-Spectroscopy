{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://130.61.85.171/api/:path*" },
    { "source": "/((?!assets/|brand/).*)", "destination": "/index.html" }
  ]
}
